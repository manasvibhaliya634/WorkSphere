# WorkSphere Environment Configuration Template
PORT=5000
NODE_ENV=development

# Local MySQL Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=worksphere

# TiDB Cloud Deployment (Set to true on Render)
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxx.root
# DB_PASSWORD=xxxxxx
# DB_NAME=worksphere
# TIDB_ENABLE_SSL=true

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
